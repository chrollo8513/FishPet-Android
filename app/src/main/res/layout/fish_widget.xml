<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/aquarium"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="MheyFish aquarium"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/fish_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F4FCFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/mood"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#C6ECFA"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/hunger_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="3dp"
        android:drawableStart="@drawable/ic_hunger"
        android:textColor="#FFF2CC"
        android:textSize="10sp" />

    <ProgressBar
        android:id="@+id/hunger_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginBottom="2dp"
        android:max="100"
        android:progressDrawable="@drawable/hunger_progress" />

    <TextView
        android:id="@+id/health_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#D9FFE4"
        android:textSize="10sp" />

    <ProgressBar
        android:id="@+id/health_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:max="100"
        android:progressDrawable="@drawable/health_progress" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/feed_feedback"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#D5F4FF"
            android:textSize="9sp" />

        <Button
            android:id="@+id/feed"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/feed_button"
            android:minWidth="62dp"
            android:textAllCaps="false"
            android:textColor="#073B5A"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
