<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/aquarium" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="Fish aquarium" android:scaleType="fitCenter"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="FishPet" android:textSize="11sp" android:textColor="#FFFFFF" android:maxLines="2"/>
        <Button android:id="@+id/feed" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Feed" android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>
